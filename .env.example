# Copy to .env for local development. Never commit .env.
# development | test | production
ENVIRONMENT=development

# Gemini API key from AI Studio. Leave blank to run with rule-based fallbacks.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_LITE_MODEL=gemini-3.5-flash-lite
# Tried in order when the main model is overloaded, rate limited or hung.
# Comma separated, no spaces. Leave empty for no fallback.
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite

# Overall time budget for one AI-backed request, in seconds.
AI_DEADLINE_SECONDS=25

# Most Gemini requests per day (IST), retries included. 0 turns AI off.
# A safety net only: also set a requests-per-day quota in Google Cloud.
AI_DAILY_CALL_LIMIT=500

# Per-IP limit on endpoints that call Gemini.
RATE_LIMIT_LLM=10/minute

# Largest accepted request body, in bytes.
MAX_BODY_BYTES=262144

# Tests only: run `pytest e2e` with a browser that is already installed ("chrome" or
# "msedge") instead of Playwright's own Chromium. Leave unset in CI.
# E2E_BROWSER_CHANNEL=chrome
